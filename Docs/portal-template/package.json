{
  "name": "docs-portal-template",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "build": "astro build",
    "validate": "node scripts/validate-site.mjs",
    "test:validator": "node scripts/validate-site.mjs --self-check",
    "verify:root": "cross-env SITE_URL=https://example.com BASE_PATH=/ npm run build && cross-env BASE_PATH=/ npm run validate",
    "verify:subpath": "cross-env SITE_URL=https://example.com BASE_PATH=/example-project npm run build && cross-env BASE_PATH=/example-project npm run validate"
  },
  "dependencies": {
    "@astrojs/mdx": "6.0.3",
    "@astrojs/react": "5.0.7",
    "@astrojs/starlight": "0.40.0",
    "astro": "6.4.6",
    "likec4": "1.55.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "starlight-versions": "0.9.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "cross-env": "10.1.0",
    "typescript": "6.0.3"
  }
}
