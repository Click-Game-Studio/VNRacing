// ===========================================================================
// VNRacing (PrototypeRacing) — C4 model specification
// ---------------------------------------------------------------------------
// Element kinds + relationship + styling. LikeC4 merges every *.c4 file in
// this directory, so this file only declares the vocabulary; the model lives
// in model.c4 and the drill-down views in views.c4.
//
// Sources of truth (hand-curated, then cross-checked against code):
//   - Docs/VNRacing_HLD.md  (domain Mermaid diagrams, container responsibilities)
//   - Docs/VNRacing_LLD.md  (real C++ class names, ownership, delegates)
//   - CodeGraph DB          (.codegraph/codegraph.db — call/contains edges)
//   - tooling/blueprint_index.json (17,675 assets, grouped by feature path)
// ===========================================================================

specification {

  element actor {
    style {
      shape person
      color secondary
    }
  }

  // Third-party / external services outside the game client boundary.
  element externalSystem {
    style {
      shape rectangle
      color muted
    }
  }

  // The deployable / runnable system (the UE5 mobile client, the dedicated server).
  element system {
    style {
      shape rectangle
      color primary
    }
  }

  // Level-2: a runtime grouping inside the client (UI, Gameplay, Meta, ...).
  element container {
    style {
      shape rectangle
      color blue
    }
  }

  // Level-3 grouping: an OpenProject Epic (Drive Mode, VNTour, ...).
  element epic {
    style {
      shape rectangle
      color amber
    }
  }

  // Level-3 grouping: one product Feature from the OpenProject 2026-06-15 list
  // (spans C++ + Blueprint). See Docs/traceability.md.
  element feature {
    style {
      shape rectangle
      color indigo
    }
  }

  // Leaf: a real C++ class / subsystem, or a named Blueprint group.
  element code {
    style {
      shape rectangle
      color sky
    }
  }

  // A Blueprint-only leaf (no C++ owner) — visually distinct from C++ code.
  element blueprint {
    style {
      shape rectangle
      color green
    }
  }

  tag hotspot
  tag external
  tag backend-target
}
