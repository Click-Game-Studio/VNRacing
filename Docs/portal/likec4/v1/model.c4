// ===========================================================================
// VNRacing — C4 model (elements + relationships)
// ---------------------------------------------------------------------------
// 3 nested levels:
//   System Context  : player + game client + external services
//   Container        : 6 runtime groupings inside the client
//   Feature (L3)     : OpenProject 2026-06-15 product taxonomy
//                      Epic -> Feature -> real C++ classes / BPs
//
// STRUCTURE = the OpenProject 2026-06-15 feature list (contract).
// LEAVES     = real code, cross-checked against Source/ + CodeGraph.
// Each feature carries its OpenProject id; see Docs/traceability.md for the
// id <-> code <-> status master and Docs/_legacy_F-map.md for old F01-F17.
// ===========================================================================

model {

  //=========================================================================
  // ACTORS
  //=========================================================================
  player = actor 'Mobile Player' {
    description 'iOS / Android racer. Touch input, race + meta-game navigation.'
  }

  //=========================================================================
  // EXTERNAL SYSTEMS  (outside the client boundary)
  //=========================================================================
  nakama = externalSystem 'Nakama' {
    #external
    description 'Auth, session, realtime socket, matchmaking. Reached via Nakama UE SDK plugin.'
  }
  edgegap = externalSystem 'Edgegap / Dedicated Server' {
    #external #backend-target
    description 'PvP server hosting boundary. Plugin enabled; server-authoritative race flow NOT confirmed in source (design target).'
  }
  gameAnalytics = externalSystem 'GameAnalytics' {
    #external
    description 'Telemetry service. Observational only — no game state depends on delivery.'
  }
  appStore = externalSystem 'App Store / Play Billing' {
    #external #backend-target
    description 'IAP entitlement provider. Source ships a Mock provider; native iOS/Android providers are stubbed.'
  }
  cdn = externalSystem 'Content CDN' {
    #external
    description 'Hosts pak/chunk files for on-demand download (ChunkDownloader). AWS S3 target.'
  }
  backendEconomy = externalSystem 'Backend Economy Services' {
    #external #backend-target
    description 'Profile / Economy / Inventory / Progression source-of-truth. Architecture target — not yet authoritative in source.'
  }

  //=========================================================================
  // SYSTEM  — the UE5 mobile client
  //=========================================================================
  client = system 'VNRacing UE5 Mobile Client' {
    description 'Single-module (PrototypeRacing) UE5.6 client. Holds gameplay runtime, meta/economy, online client services, UI, debug tooling.'

    //---------------------------------------------------------------------
    // CONTAINERS (Level 2)
    //---------------------------------------------------------------------
    ui = container 'UI / UMG Layer' {
      description 'UMG widgets + HUD. 235 WidgetBlueprints (Game/UI/UI_wireFrame is the main app shell). Reads subsystem state via delegates.'
    }
    gameplay = container 'Gameplay Runtime' {
      description 'Race lifecycle, vehicle physics, AI, pooling. Level-bound GameMode / GameState / RaceTrackManager + SimpleCarPhysics plugin.'
    }
    meta = container 'Meta / Economy Subsystems' {
      description 'GameInstance subsystems: progression, customization, inventory, profile/wallet, rewards, IAP.'
    }
    backendComm = container 'Backend Communication' {
      description 'Client-side gateway to Nakama + match orchestration + server snapshot sync.'
    }
    localData = container 'Local Data / SaveGame' {
      description 'DataTable registry (GameInstance) + SaveGame slots. Local source of truth for offline/prototype.'
    }
    tooling = container 'Debug / Tooling' {
      description 'Debug modules, track-test batch sim, performance + PSO instrumentation. Must not be a shipping dependency.'
    }

    //=====================================================================
    // EPIC: Drive Mode (#151)
    //=====================================================================
    epicDrive = epic 'Epic: Drive Mode (#151)' {
      description 'Cảm giác lái: physics va chạm arcade, đua cơ bản, NOS, RAMP, camera, settings.'

      dmPhys = feature 'DM-PHYS DriveMode - Physics (#279)' {
        description 'Player + AI vehicle simulation, customization-driven stats, collision/wall correction, remote smoothing. OpenProject #279.'

        f01_simcar     = code 'ASimulatePhysicsCar' { #hotspot description 'SimpleCarPhysics plugin. Per-frame Tick: suspension/wheel update, anim sync, net upstream. Core gameplay actor.' }
        f01_chaos      = code 'UCustomChaosWheeledVehicle' { #hotspot description 'Chaos wheeled movement override. TickComponent enabled but empty body.' }
        f01_suspension = code 'UCustomSuspensionComponent' { description 'Per-wheel suspension, ticks every frame per car.' }
        f01_factory    = code 'UVehicleFactory' { description 'Standardized vehicle creation/configuration helper.' }
        f01_pid        = code 'APIDControl' { description 'PID controller actor (ticks).' }
        f01_bp_cars    = blueprint 'Customizable car BPs' { description 'BP_Customizable_VF8 / MercedesBenz / VFLuxA*, BP_SportsCar_Pawn (Game/VehicleTemplate). Visual + component config over the C++ pawn.' }
      }

      dmRace = feature 'DM-RACE Basic Racing (#324)' {
        description 'Race lifecycle: checkpoint/lap/ranking/timer, intro/outro, AI setup, result hand-off. Arcade/drift feel. OpenProject #324.'
        link ../ld/DM-RACE_basic_racing.html 'Low-Level Design (DM-RACE)'

        f02_rtm       = code 'ARaceTrackManager' { #hotspot description 'Central race orchestrator. Tick -> HandleUpdateRanking every frame. O(n) distance recompute + 2 TArray copies per frame.' }
        f02_gm        = code 'ARacingCarGameMode' { description 'Spawns race manager + cars, player login/ready, PSO drone.' }
        f02_gs        = code 'ARaceGameState' { description 'Replicated car readiness + car list.' }
        f02_ctrl      = code 'ARacingCarController' { #hotspot description 'Player controller. HandleRankingUpdateCallToClient does GetAllActorsOfClass + O(n^2) match per update.' }
        f02_checkpoint= code 'ARaceCheckpoint' { description 'Checkpoint trigger -> HandleVehicleDetectedAtCheckpoint.' }
        f02_racecomp  = code 'URaceComponent' { #hotspot description 'Tick enabled (bCanEverTick=true) with empty TickComponent body.' }
        f02_bp_flow   = blueprint 'Race flow BPs' { description 'BP_CheckPoint, BP_BoostCheckPoint, BP_DriftZone_Child (Event Tick enabled); CutScene intro/outro sequences.' }
      }

      dmNos = feature 'DM-NOS NOS (#334)' {
        description 'Nitro/NOS: thu thập qua drift + boost checkpoint, kích hoạt tăng tốc; AI cũng dùng NOS. OpenProject #334.'

        dmnos_boostcp = code 'ABoostCheckPoint' { description 'Boost/NOS checkpoint trigger trên track.' }
        dmnos_nitro   = code 'ASimulatePhysicsCar::BoostNitro' { description 'Nitro application trên xe (BoostNitro/BoostNitrous, ERampBoost/Boosting states).' }
      }

      dmRamp = feature 'DM-RAMP RAMP (#335)' {
        description 'Ramp/bệ nhảy: vùng kích hoạt nhảy + boost khi qua ramp. OpenProject #335.'

        dmramp_zone = code 'ARampZone' { description 'Ramp trigger zone (RampZone.h/.cpp). Kích hoạt Jump + RampBoost trên xe.' }
      }

      dmCam = feature 'DM-CAM CAMERA (#336)' {
        description 'Camera đua: chase cam, tự xoay + xoay chủ động. OpenProject #336.'

        f01_camera = code 'AFollowCarCamera' { description 'Chase camera. TickFunction + GetComponentByClass lookups on target.' }
      }

      dmSet = feature 'DM-SET SETTING (#338)' {
        description 'Cài đặt graphics/gameplay, độ nhạy steering, lưu setting theo xe. OpenProject #338.'

        f15_sub = code 'UCarSettingSubsystem' { description 'Setting load/apply, save to CarSaveSetting.' }
        f15_gfx = code 'AGraphicsSettingsActor' { description 'Applies graphics scalability settings.' }
      }
    }

    //=====================================================================
    // EPIC: VNTour (#183)
    //=====================================================================
    epicVNTour = epic 'Epic: VNTour (#183)' {
      description 'Vòng lặp meta: map đua, tiến trình city/goals/unlock, area-track, car-progression, reward.'

      vtMap = feature 'VT-MAP VN Tour - Map Đua / Huế City (#168/#169)' {
        description 'Nội dung level các map đua (Huế: Đại Nội / Quốc Học / Hồ Thuỷ Tiên...). Là asset/level — dữ liệu nạp qua ProgressionData tables, không phải subsystem code. OpenProject #168/#169.'

        vtmap_data = code 'ProgressionData map/area/track tables' { description 'DataTable map/area/track định nghĩa cấu trúc VN Tour; level content do team Level/2D/3D sản xuất.' }
      }

      vtCity = feature 'VT-CITY City Progression (#329)' {
        description 'Tiến trình city/area/track, city goals (config/unlock/reward), car unlock, map scene unlock. Subs: Goals Unlock #331, Goals Config #333, Goals Reward #340, Car Unlock #337, Map Scene Unlock #339. OpenProject #329.'
        link ../ld/VT-CITY_city_progression.html 'Low-Level Design (VT-CITY)'

        f05_center = code 'UProgressionCenterSubsystem' { description 'Facade: SetupRaceData, HandleRaceCompleted, reward calc, analytics, travel.' }
        f05_prog   = code 'UProgressionSubsystem' { #hotspot description 'VN Tour data, unlock state, RecordRaceResult, CityGoals (tier pool, BuildAssignedGoals, CheckCityGoalsAndUnlockNextCity, GrantRewardsForCompletedGoal). 2641-line file.' }
      }

      vtTrack = feature 'VT-TRACK Area-Track Unlock (#341)' {
        description 'Mở khoá area/track, chọn track + load + track record (vị thứ), cấu hình độ khó track. Subs: Track Selection #342, Track config #343. Hiện thực trong UProgressionSubsystem (UnlockNext, RecalculateTrackDifficulty, OnTrackUnlocked). OpenProject #341.'

        vttrack_cfg = code 'Track unlock/config (in UProgressionSubsystem)' { description 'UnlockNext, OnTrackUnlocked, RecalculateTrackDifficulty, OnTrackDifficultyRecalculated. Track record/selection qua progression data.' }
      }

      vtCarProg = feature 'VT-CARPROG Car-Progression (#344)' {
        description 'CR khởi đầu tăng dần theo chiều dài Progression; Dummy Car cho các City. OpenProject #344.'

        f05_rating = code 'UCarRatingSubsystem' { description 'CR tables, performance gate, AI CR by city/difficulty, ResolveStartingCarRatingLevelByCityIndex.' }
      }

      vtReward = feature 'VT-REWARD Reward (#345)' {
        description 'Trao thưởng Cash/Item theo vị thứ, LootCrate (Common/UnCommon/Rare), achievements, fan-service in-race. OpenProject #345.'
        link ../ld/VT-REWARD_reward.html 'Low-Level Design (VT-REWARD)'

        f09_reward = code 'URewardCenterSubsystem' { #hotspot description 'Reward token roll, LootCrate, GrantGoalCompletionRewards; item icon LoadSynchronous on resolve.' }
        f09_ach    = code 'UAchievementSubsystem' { description 'Achievement progress on race completion.' }
        f09_fan    = code 'UFanServiceSubsystem' { #hotspot description 'In-race drift/fly/speed checks. Ticks every frame while a check is active.' }
      }
    }

    //=====================================================================
    // EPIC: GAME MODE (#272)
    //=====================================================================
    epicGameMode = epic 'Epic: GAME MODE (#272)' {
      description 'Các chế độ chơi: Multiplayer (online), Daily Challenge.'

      gmMp = feature 'GM-MP MULTIPLAYER (#273)' {
        description 'Đua online: client sims, backend Nakama auth/session/match, waiting room. Race flow server-authoritative CHƯA hiện thực (gap). OpenProject #273.'
        link ../ld/GM-MP_multiplayer.html 'Low-Level Design (GM-MP)'

        f11_nakama = code 'UNakamaServiceSubsystem' { description 'Client/session/realtime lifecycle, auth flows. Back-refs to session + match (bidirectional coupling).' }
        f11_match  = code 'UMatchServiceSubsystem' { description 'Matchmaking query build, ticket, matched/presence events, JSON payload parse.' }
        f11_net    = code 'UNakamaNetworkSubsystem' { description 'Network-level Nakama plumbing.' }
        f11_types  = code 'BackendContractTypes' { description 'Shared backend request/response structs.' }
        f12_waitroom = code 'AMultiplayerWaitingRoomGameMode' { #backend-target description 'Join-token validation, waiting room travel. Server-authoritative race flow not implemented.' }
      }

      gmDc = feature 'GM-DC DAILY CHALLENGE (#274)' {
        #backend-target
        description '❌ GAP: chưa có code. Cần subsystem nhiệm vụ hằng ngày (pool riêng + reset theo ngày + UI). FanServiceSubsystem chỉ là challenge trong-race, không tái dùng trực tiếp. OpenProject #274.'

        gmdc_gap = code 'TODO: DailyChallengeSubsystem' { description 'Chưa tồn tại trong source. Placeholder cho việc xây mới.' }
      }
    }

    //=====================================================================
    // EPIC: CUSTOMIZE (#298)
    //=====================================================================
    epicCustomize = epic 'Epic: CUSTOMIZE (#298)' {
      description 'Tuỳ biến xe + không gian Customize Room + main menu level.'

      cuRoom = feature 'CU-ROOM Customize Room (#299)' {
        description 'Tuỳ biến visual + performance, CR calc, save/load, asset resolution; level Customize Room. OpenProject #299.'
        link ../ld/CU-ROOM_customize_room.html 'Low-Level Design (CU-ROOM)'

        f06_mgr   = code 'UCarCustomizationManager' { #hotspot description '2078-line subsystem. CalculatePerformanceStats does DataTable FindRow per part; mesh/material LoadSynchronous (blocking).' }
        f06_light = code 'UCustomizeCarSubsystem' { description 'Lighter mesh/material application by part name.' }
        f06_save  = code 'UCarSaveGameManager' { description 'Persists car configs / inventory / profile / progression slots.' }
        f06_json  = code 'CarConfigurationJsonSerializer' { description 'Serialize car config to JSON (backend-sync prep).' }
        f06_bp    = blueprint 'Customize UI BPs' { description 'WBP_UI491/493/496_CarCustomize, WBP_PerformanceStat (Event Tick), CarCustomize/UI buttons.' }
      }

      cuMenu = feature 'CU-MENU Main menu_Level (#320)' {
        description 'Nội dung main menu / level shell. Là UI/level content, không phải subsystem code. OpenProject #320.'

        cumenu_bp = blueprint 'Main menu UI / level' { description 'Game/UI/UI_wireFrame app shell + main menu level content.' }
      }
    }

    //=====================================================================
    // FEATURE (top-level): CDN (#250)
    //=====================================================================
    cdnFeat = feature 'CDN Content Download (#250)' {
      description 'Tải pak/chunk on-demand + mount, patch widget; chia chunk upload AWS. OpenProject #250.'
      link ../ld/CDN_content_download.html 'Low-Level Design (CDN)'

      f13_sub  = code 'UChunkDownloaderSubsystem' { description 'Patch lifecycle, chunk mount, retry. Guards re-entrant patch requests.' }
      f13_ctrl = code 'UChunkDownloaderController' { #hotspot description 'Patch widget spawn; LoadSynchronous of patch widget class.' }
      f13_wid  = code 'UChunkDownloaderWidget' { #hotspot description 'Progress UI. OpenDownloadableMap does GetAllActorsOfClass + StaticLoadClass + on-screen debug msgs.' }
    }

    //=====================================================================
    // EPIC: Hệ thống nền (Support) — code thật, KHÔNG có feature trong CSV.
    // Ứng viên refactor. Xem Docs/traceability.md.
    //=====================================================================
    epicSupport = epic 'Hệ thống nền (Support — ngoài CSV)' {
      description 'Subsystem có code thật nhưng không nằm trong danh sách feature OpenProject 2026-06-15. Giữ để không mất độ phủ codebase; là ứng viên refactor.'

      supAi = feature 'SUP-AI Racer AI' {
        description 'AI scheduling + per-car driving decisions, racing-line + NOS behavior. (cũ F03)'

        f03_mgr  = code 'UAIManagerSubsystem' { description 'Round-robin: ticks at most one AI per frame. Schedule list with phase offsets.' }
        f03_dec  = code 'UAIDecisionComponent' { #hotspot description 'Per-car TickComponent: EvaluateDrivingDecision + racing-line/NOS interval checks every frame on every AI car.' }
        f03_guide= code 'UGuideLineSubsystem' { description 'Lane/contender resolution, closest track mark via GetAllActorsOfClass on init.' }
      }

      supPool = feature 'SUP-POOL Object Pooling' {
        description 'World-scoped reusable actor pool. (cũ F04)'

        f04_pool = code 'UActorObjectPoolSubsystem' { #hotspot description 'GetActor/ReleaseActor. Linear scan of Availability array on every acquire + release.' }
        f04_iface= code 'IPoolObjectInterface' { description 'OnCreate / OnGetFromPool / OnReleaseToPool contract.' }
      }

      supInv = feature 'SUP-INV Inventory' {
        description 'Item ownership, equip/favorite, definition database, persistence. (cũ F07)'

        f07_mgr = code 'UInventoryManager' { description 'Add/remove/equip. Backend-authority lock gate present. Save on every mutation.' }
        f07_db  = code 'UItemDatabase' { #hotspot description 'Cache built from DataTable. GetItemDefinition bypasses cache (FindRow direct).' }
      }

      supProf = feature 'SUP-PROF User Profile / Economy' {
        description 'Identity, wallet (Cash/Coin), stats, fuel/session energy, snapshot sync. (cũ F08)'

        f08_profile = code 'UProfileManagerSubsystem' { description 'Wallet earn/spend, name filter, top-speed sampling (5Hz timer). Bad-word scan is O(name * words).' }
        f08_session = code 'URaceSessionSubsystem' { description 'Fuel ticks, recharge timers, current race/session data.' }
        f08_snap    = code 'USnapshotAdapterSubsystem' { description 'Player snapshot load/save via Nakama RPC.' }
      }

      supShop = feature 'SUP-SHOP Shop / IAP / Ads' {
        description 'Store products + purchase orchestration. Provider-abstracted. (cũ F10)'

        f10_commerce = code 'UCommerceSubsystem' { #hotspot #backend-target description 'Purchase orchestration. Only Mock provider wired (Android/iOS providers commented out). No server verification yet.' }
        f10_mock     = code 'FMockCommerceProvider' { description 'Editor/dev stand-in provider.' }
        f10_bp       = blueprint 'Shop UI BPs' { description 'WBP_Shop, WBP_Popup_Shopping, WBP_Card_DLC, WBP_Card_BoosterBundles, WBP_Play_Rewards_WatchAds.' }
      }

      supTut = feature 'SUP-TUT Tutorial / Onboarding' {
        description 'Scripted tutorial steps, tooltip pool, trigger conditions, control lock. (cũ F14)'

        f14_mgr  = code 'UTutorialManagerSubsystem' { description 'Tutorial state, tooltip pool, trigger dispatch, control lock/unlock. 674-line file.' }
        f14_trig = code 'UTriggerCondition' { description 'Condition subclasses, e.g. TriggerCondition_CheckpointPassed.' }
        f14_bp   = blueprint 'Tutorial BPs' { description 'WBP_ScriptTutorial, WBP_TooltipTutorial, BP_Trigger_PassCheckpoint_*.' }
      }

      supDbg = feature 'SUP-DBG Debug & Track Test' {
        description 'Debug module framework + batch AI/track simulation + data export. (cũ F16)'

        f16_debug = code 'UDebugToolsSubsystem' { description 'Hosts 10 DebugModule_* (Camera/Cheat/Gameplay/Overlay/Progression/Rendering/TestMaps/TrackLogic/Tutorial/Vehicle).' }
        f16_batch = code 'UBatchSimulationManager' { description 'State-machine batch sim. Ticks but dispatches by state (cheap when idle).' }
        f16_mistake = code 'UMistakeDetector' { #hotspot description 'Per-frame TickComponent; GetAllActorsOfClassWithTag for boundary splines.' }
        f16_collector = code 'URaceDataCollector' { description 'Per-frame TickComponent data capture during test runs.' }
      }

      supPerf = feature 'SUP-PERF Performance & PSO' {
        description 'Runtime perf instrumentation, significance culling, PSO/shader warmup. (cũ F17)'

        f17_perf = code 'UPerformanceMonitorSubsystem' { description 'Runtime FPS/perf instrumentation.' }
        f17_sig  = code 'ULiteSignificanceManager' { #hotspot description 'Timer-driven (0.25s) distance culling of actors + Niagara. Niagara branch uses == comparison (logic bug risk).' }
        f17_pso  = code 'APSOEffectManager' { #hotspot description 'PSO warmup VFX spawn. Tick enabled but empty body.' }
        f17_rest = code 'ARestLevelManager' { description 'Rest-level FPS-stability gate before travel. Per-frame frame-time tracking while checking.' }
      }
    }
  }

  //=========================================================================
  // RELATIONSHIPS — System Context level
  //=========================================================================
  player -> client 'plays / touch input'
  client -> nakama 'auth, session, realtime, matchmaking'
  client -> gameAnalytics 'telemetry events'
  client -> appStore 'IAP product query + purchase'
  client -> cdn 'download pak/chunk content'
  client -> backendEconomy 'profile/economy sync (target)' #backend-target
  nakama -> edgegap 'route / allocate server (target)' #backend-target

  //=========================================================================
  // RELATIONSHIPS — Container level
  //=========================================================================
  ui -> gameplay 'start race, read race state'
  ui -> meta 'customize, view progression, buy, inventory'
  ui -> backendComm 'login, matchmaking'
  ui -> tooling 'debug panels (dev builds)'
  gameplay -> meta 'race result -> progression/profile'
  gameplay -> localData 'read race/track/AI config'
  meta -> localData 'save/load configs, wallet, progression'
  meta -> backendComm 'economy sync (target)' #backend-target
  meta -> gameAnalytics 'progression/economy telemetry'
  backendComm -> nakama 'SDK calls'
  tooling -> gameplay 'inspect / drive batch sim'

  //=========================================================================
  // RELATIONSHIPS — Component level (cross-feature, code-grounded)
  // Leaf ids are stable across the re-grouping; relationships unchanged.
  //=========================================================================

  // DM-RACE race flow
  f02_gm -> f02_rtm 'spawns + starts'
  f02_gm -> f01_simcar 'SpawnPlayerCar'
  f02_gm -> f02_gs 'register ready cars'
  f02_checkpoint -> f02_rtm 'HandleVehicleDetectedAtCheckpoint'
  f02_rtm -> f01_simcar 'SetRaceRank, freeze, SignalRaceBegin'
  f02_rtm -> f05_center 'HandleRaceCompleted'
  f02_rtm -> f06_mgr 'resolve AI car visuals/stats'
  f02_rtm -> f08_profile 'profile lookup'
  f02_rtm -> f05_rating 'AI car rating'
  f02_ctrl -> f02_rtm 'PlayerIsReady'
  f02_ctrl -> f01_simcar 'apply ranking to cars'

  // DM-PHYS physics
  f01_simcar -> f01_suspension 'UpdateTick per wheel'
  f01_simcar -> f01_chaos 'movement component'
  f01_simcar -> f03_guide 'wall-correction distance'
  f01_camera -> f01_simcar 'follow target'

  // DM-NOS / DM-RAMP
  dmnos_boostcp -> f01_simcar 'apply nitro on overlap'
  dmnos_nitro -> f01_simcar 'BoostNitro on pawn'
  dmramp_zone -> f01_simcar 'Jump + RampBoost on overlap'
  f03_dec -> dmnos_nitro 'AI NOS interval trigger'

  // SUP-AI
  f03_mgr -> f01_simcar 'AutoDrive(dt) round-robin'
  f03_mgr -> f06_mgr 'CalculatePerformanceStats for AI tuning'
  f03_dec -> f03_guide 'SwitchToNewLane, lane queries'
  f02_rtm -> f03_dec 'ApplyAIDifficultyTuning'

  // SUP-POOL — consumed by gameplay spawners
  f02_rtm -> f04_pool 'acquire/release transient actors'

  // VT-CITY / CU-ROOM economy
  f05_center -> f05_prog 'RecordRaceResult, unlock, city goals'
  f05_center -> f05_rating 'IsPerformanceGatePassed'
  f05_center -> f09_reward 'reward calc'
  f05_center -> f09_ach 'achievement progress'
  f05_center -> f08_session 'fuel spend'
  f05_center -> f08_profile 'EarnCurrency'
  f05_center -> f06_save 'save progression'
  f05_center -> f09_fan 'evaluate fan service'
  f05_prog -> f09_reward 'GrantRewardsForCompletedGoal (goals reward)'
  f05_prog -> vttrack_cfg 'track unlock/difficulty'
  f06_mgr -> f05_rating 'CR / stats'
  f06_mgr -> f08_profile 'HasEnoughCurrency / SpendCurrency'
  f06_mgr -> f07_mgr 'required-item check on upgrade'
  f06_mgr -> f06_save 'SaveCarConfiguration'

  // SUP-INV / VT-REWARD inventory + rewards
  f09_reward -> f07_mgr 'grant item'
  f09_reward -> f08_profile 'grant currency'
  f07_mgr -> f07_db 'GetItemDefinition'
  f07_mgr -> f06_save 'save inventory'

  // SUP-PROF profile
  f08_profile -> f06_save 'save profile'
  f08_session -> f06_save 'save fuel/session'
  f08_snap -> f11_nakama 'RPC snapshot'

  // VT-REWARD fan service
  f09_fan -> f01_simcar 'IsDrifting / GetInAir / speed sampling'

  // GM-MP online
  f11_match -> f11_nakama 'realtime client + session'
  f11_nakama -> f08_session 'session refs'
  f11_nakama -> f11_match 'back-ref (coupling)'
  f12_waitroom -> f11_match 'join token from match data'

  // CDN content download
  f13_ctrl -> f13_sub 'RetryPatch / start'
  f13_wid -> f13_sub 'progress + mount status'

  // SUP-TUT tutorial
  f02_rtm -> f14_mgr 'TriggerOnCheckpointPassed'
  f05_center -> f14_mgr 'ShowTooltip(OutOfFuel)'
  f14_mgr -> f14_trig 'evaluate conditions'

  // SUP-DBG tooling
  f16_debug -> f05_center 'progression debug'
  f16_batch -> f02_gm 'drive batch race runs'
  f16_mistake -> f01_simcar 'detect off-track mistakes'

  // SUP-PERF (cross-cutting — registers gameplay actors)
  f17_sig -> f01_simcar 'distance-cull register'
  f17_rest -> f05_center 'TravelToCurrentRace when stable'
  f02_gm -> f17_pso 'spawn PSO drone/effects'
}




